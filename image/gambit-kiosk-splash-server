#!/usr/bin/env python3
import argparse
import json
import os
import subprocess
import urllib.error
import urllib.request
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import parse_qs, urlparse


def target_ready(url: str) -> bool:
    try:
        with urllib.request.urlopen(url, timeout=0.7):
            return True
    except (OSError, urllib.error.URLError):
        return False


def command_output(args: list[str], timeout: float = 1.0) -> str:
    try:
        return subprocess.run(
            args,
            check=False,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            timeout=timeout,
        ).stdout
    except (OSError, subprocess.TimeoutExpired):
        return ""


def viam_agent_active() -> bool:
    return command_output(["systemctl", "is-active", "viam-agent.service"]).strip() == "active"


def network_online() -> bool:
    return bool(command_output(["ip", "route", "show", "default"]).strip())


def wifi_saved() -> bool:
    """A Wi-Fi network is saved for the box to join: any NetworkManager Wi-Fi
    profile but viam-agent's own setup hotspot, the one in mode ap."""
    for line in command_output(["nmcli", "-t", "-f", "UUID,TYPE", "connection", "show"]).splitlines():
        uuid, _, kind = line.partition(":")
        if kind != "802-11-wireless":
            continue
        mode = command_output(["nmcli", "-g", "802-11-wireless.mode", "connection", "show", uuid]).strip()
        if mode != "ap":
            return True
    return False


def viam_agent_logs() -> str:
    return command_output(
        ["journalctl", "-u", "viam-agent.service", "-n", "120", "--no-pager"],
        timeout=1.5,
    )


def package_count() -> int:
    package_root = "/root/.viam/packages/data"
    try:
        return len([name for name in os.listdir(package_root) if not name.startswith(".")])
    except OSError:
        return 0


# gambit-setup-name (GMBT-1471) names the box's setup hotspot and Bluetooth
# device here, gambit-setup-<id> after its CPU serial, before viam-agent starts
# and reads this same file. The splash shows that name and never works out one
# of its own, so the screen and the app's Bluetooth list can't disagree.
VIAM_DEFAULTS = "/etc/viam-defaults.json"
SETUP_PREFIX = "gambit-setup-"
# viam-agent serves its setup page on its hotspot, at an address it hard-codes.
SETUP_ADDRESS = "10.42.0.1"
# Where the setup QR code points (GMBT-1470, chef's infra/setup): the Gambit
# app opens it at Bluetooth pairing with gambit-setup-<id> chosen, and a phone
# without the app gets TestFlight.
SETUP_LINK = "https://gambit-setup.chef-workspace.workers.dev/setup?device="


def setup_network() -> dict[str, str]:
    """The setup name (hotspot and Bluetooth) and hotspot password; the name is
    empty when /etc/viam-defaults.json gives none."""
    try:
        with open(VIAM_DEFAULTS, encoding="utf-8") as f:
            conf = json.load(f)["network_configuration"]
        ssid, password = conf.get("hotspot_ssid"), conf.get("hotspot_password")
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        ssid = password = None
    # viamsetup is the agent's own password when the file sets none.
    return {"ssid": str(ssid or ""), "password": str(password or "viamsetup"), "address": SETUP_ADDRESS}


def setup_qr() -> bytes:
    """This box's setup QR code, as SVG; empty without a gambit-setup-<id> name
    or qrencode."""
    ssid = setup_network()["ssid"]
    if not ssid.startswith(SETUP_PREFIX):
        return b""
    try:
        return subprocess.run(
            ["qrencode", "-t", "SVG", "-l", "M", "-o", "-", SETUP_LINK + ssid[len(SETUP_PREFIX):]],
            check=True,
            capture_output=True,
            timeout=2,
        ).stdout
    except (OSError, subprocess.SubprocessError):
        return b""


# The setup QR code stays off until its TestFlight path can be tested (Jacob,
# 2026-11-13). The machine's config turns it on, in core's attributes:
# "setup": {"show_qr_code": true}. gambit-setup-options copies that block here
# at boot, from viam-server's cached config.
SETUP_OPTIONS = "/run/gambit/setup.json"


def setup_qr_on() -> bool:
    try:
        with open(SETUP_OPTIONS, encoding="utf-8") as f:
            return json.load(f).get("show_qr_code") is True
    except (OSError, ValueError, AttributeError):
        return False


def hotspot_up() -> bool:
    return f"inet {SETUP_ADDRESS}/" in command_output(["ip", "-4", "-o", "addr", "show"])


def waiting_for_setup(waiting: str, hotspot: bool) -> dict[str, object]:
    """viam-agent is in setup mode, waiting for someone with the Gambit app:
    "setup" when the box has no credentials, "wifi" when it has them but
    couldn't get on Wi-Fi. The app lists the box over Bluetooth by its setup
    name, so the name shows in both; the hotspot only while it's up."""
    network = setup_network()
    state: dict[str, object] = {"ready": False, "waiting": waiting}
    if network["ssid"]:
        state["name"] = network["ssid"]
        if hotspot:
            state["hotspot"] = network
        if setup_qr_on():
            state["qr"] = True
    return state


def provisioning_state(target: str) -> dict[str, object]:
    # A box with no Wi-Fi saved, and no other way online, waits for someone to
    # give it Wi-Fi. That holds even when Chef answers: a factory reset keeps
    # /etc/viam.json and forgets only the Wi-Fi (GMBT-1624), so Chef starts
    # offline from its cached config. The page leaves for Chef only when this
    # says ready.
    needs_wifi = not wifi_saved() and not network_online()
    if not needs_wifi and target_ready(target):
        return {"ready": True, "message": "Opening Gambit..."}

    if not viam_agent_active():
        return {"ready": False, "message": "Starting up..."}

    # The agent advertises over Bluetooth as soon as it starts without
    # /etc/viam.json, or with it and no Wi-Fi, and opens its hotspot soon
    # after. With credentials and a saved network, the hotspot means the agent
    # went back to setup mode because it couldn't join that network.
    configured = os.path.exists("/etc/viam.json")
    hotspot = hotspot_up()
    if not configured or hotspot or needs_wifi:
        return waiting_for_setup("wifi" if configured else "setup", hotspot)

    if not network_online():
        return {"ready": False, "message": "Connecting to Wi-Fi..."}

    logs = viam_agent_logs()
    installing = (
        "Collecting " in logs
        or "Installing collected packages" in logs
        or "Using cached " in logs
        or "Successfully installed" in logs
        or "modmanager" in logs
    )
    if installing or package_count() > 0:
        return {
            "ready": False,
            "message": "Configuring. Downloading software...",
        }

    return {
        "ready": False,
        "message": "Configuring. This can take a few minutes.",
    }


class Handler(SimpleHTTPRequestHandler):
    def end_headers(self) -> None:
        self.send_header("Cache-Control", "no-store")
        super().end_headers()

    def send(self, body: bytes, content_type: str) -> None:
        if not body:
            self.send_error(404)
            return
        self.send_response(200)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self) -> None:
        parsed = urlparse(self.path)
        if parsed.path == "/state":
            target = parse_qs(parsed.query).get("target", [os.environ.get("KIOSK_URL", "")])[0]
            return self.send(json.dumps(provisioning_state(target)).encode("utf-8"), "application/json")
        if parsed.path == "/setup-qr.svg":
            return self.send(setup_qr() if setup_qr_on() else b"", "image/svg+xml")
        return super().do_GET()

    def log_message(self, fmt: str, *args: object) -> None:
        return


def main() -> None:
    parser = argparse.ArgumentParser()
    parser.add_argument("--port", type=int, default=8764)
    args = parser.parse_args()
    os.chdir(os.environ.get("SPLASH_DIR", "/usr/local/share/gambit/kiosk-splash"))
    server = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    server.serve_forever()


if __name__ == "__main__":
    main()
